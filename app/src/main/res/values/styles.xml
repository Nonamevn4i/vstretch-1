<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme chính: RedMagic Cyber-Red -->
    <style name="Cyber.App" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cyber_bg</item>
        <item name="android:statusBarColor">@color/cyber_bg</item>
        <item name="android:navigationBarColor">@color/cyber_bg</item>
        <item name="android:colorAccent">@color/cyber_red</item>
        <item name="android:colorControlActivated">@color/cyber_red</item>
        <item name="android:textColorPrimary">@color/cyber_text</item>
        <item name="android:textColorSecondary">@color/cyber_muted</item>
    </style>

    <!-- Hộp thoại: nền đen, viền đỏ neon, góc vuông -->
    <style name="Cyber.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">@color/cyber_red</item>
        <item name="android:textColorPrimary">@color/cyber_text</item>
        <item name="android:textColorSecondary">@color/cyber_muted</item>
    </style>

    <!-- Cửa sổ nổi: không dùng animation thêm/bỏ cửa sổ của hệ thống (tránh khựng khi bật/tắt) -->
    <style name="Cyber.NoAnim" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
        <item name="android:windowShowAnimation">@null</item>
        <item name="android:windowHideAnimation">@null</item>
    </style>
</resources>
